{
  "name": "the-abusement-park",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint functions scripts tests *.config.js && markdownlint '**/*.md' --ignore node_modules --ignore coverage --ignore playwright-report --ignore test-results",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert 'deployed preview smoke'",
    "test:smoke": "playwright test tests/e2e/deployed-smoke.spec.js --project=desktop",
    "test:e2e:install": "playwright install chromium",
    "validate:syntax": "node scripts/validate-syntax.mjs",
    "validate:static": "node scripts/validate-static.mjs",
    "build": "npm run validate:static",
    "check": "npm run lint && npm run validate:syntax && npm run validate:static && npm run test:coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.0.3",
    "jsdom": "30.1.3",
    "markdownlint-cli": "0.49.1",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "markdownlint": "0.42.0",
    "js-yaml": "5.5.0",
    "smol-toml": "1.9.1",
    "katex": "0.19.0"
  }
}
