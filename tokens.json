{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Editorial FPL history with scoreboard density, dark sporting accents, and restrained match-day color.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.094,
          0.153
        ],
        "hex": "#111827"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.278,
          0.329,
          0.404
        ],
        "hex": "#475467"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.902,
          0.463
        ],
        "hex": "#00e676"
      }
    },
    "teal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.031,
          0.498,
          0.416
        ],
        "hex": "#087f6a"
      }
    },
    "purple": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4,
          0.278,
          0.843
        ],
        "hex": "#6647d7"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.851,
          0.176,
          0.125
        ],
        "hex": "#d92d20"
      }
    },
    "gold": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.604,
          0.404,
          0
        ],
        "hex": "#9a6700"
      }
    },
    "silver": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4,
          0.439,
          0.522
        ],
        "hex": "#667085"
      }
    },
    "bronze": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.663,
          0.31,
          0.043
        ],
        "hex": "#a94f0b"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.969
        ],
        "hex": "#f5f5f7"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.961,
          0.976
        ],
        "hex": "#f2f5f9"
      }
    },
    "surface-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.973,
          0.98,
          0.988
        ],
        "hex": "#f8fafc"
      }
    },
    "surface-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.796,
          0.835,
          0.882
        ],
        "hex": "#cbd5e1"
      }
    },
    "border-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.722,
          0.765,
          0.82
        ],
        "hex": "#b8c3d1"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bebas Neue",
        "fontSize": {
          "value": 4,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.02,
          "unit": "em"
        }
      }
    },
    "display-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bebas Neue",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.03,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-semibold": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "label-mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.6875,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    }
  }
}
